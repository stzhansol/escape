{
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Skill(update-config)"
    ]
  },
  "enabledPlugins": {
    "harness@harness-marketplace": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/save_session.sh\"",
            "timeout": 15,
            "statusMessage": "히스토리 저장 중..."
          }
        ]
      }
    ]
  }
}
